{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Root of an `openshell.json` / `openshell.toml` file.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Optional reference to the JSON schema (ignored by OpenShell).",
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "description": "Schema version of this file. Currently `1`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 1
    },
    "app": {
      "description": "Application metadata.",
      "$ref": "#/$defs/AppConfig"
    },
    "window": {
      "description": "Native window settings.",
      "$ref": "#/$defs/WindowConfig",
      "default": {
        "width": 1280.0,
        "height": 800.0,
        "resizable": true,
        "maximized": false,
        "close_to_tray": false,
        "tray": true,
        "title_bar": "native",
        "enabled": true
      }
    },
    "frontend": {
      "description": "The web frontend shown in the embedded WebView.",
      "anyOf": [
        {
          "$ref": "#/$defs/FrontendConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "services": {
      "description": "Backends, databases, workers, local AI servers, ...",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ServiceConfig"
      },
      "default": []
    },
    "runtime": {
      "description": "Runtime manager behaviour.",
      "$ref": "#/$defs/RuntimeConfig",
      "default": {
        "autostart": true,
        "background_mode": false,
        "log_buffer_lines": 10000,
        "shutdown_timeout_ms": 5000,
        "launch_at_login": false
      }
    },
    "agents": {
      "description": "Agent Interaction Layer settings (permissions, approvals, providers).",
      "$ref": "#/$defs/AgentsConfig",
      "default": {
        "enabled": true,
        "approval_timeout_ms": 120000,
        "detect_local_providers": true
      }
    },
    "capabilities": {
      "description": "Functions the application exposes to agents.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CapabilityConfig"
      },
      "default": []
    },
    "tasks": {
      "description": "Named, pre-declared commands (e.g. `test`, `lint`, `migrate`).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TaskSpec"
      },
      "default": {}
    },
    "package": {
      "description": "Installer settings (`openshell package`).",
      "$ref": "#/$defs/PackageConfig",
      "default": {}
    },
    "databases": {
      "description": "Built-in databases (SQLite), managed by OpenShell: created, migrated, exposed to services\n(`OPENSHELL_DB_<NAME>`, `DATABASE_URL`), to the frontend SDK and – if allowed – to agents.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DatabaseConfig"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "app"
  ],
  "$defs": {
    "AppConfig": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Human readable application name (used as window title by default).",
          "type": "string"
        },
        "id": {
          "description": "Reverse-DNS identifier, e.g. `com.example.myapp`.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "description": "Application icon (PNG, ideally 512x512) used for the window and installers.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "WindowConfig": {
      "type": "object",
      "properties": {
        "title": {
          "description": "Window title. Defaults to `app.name`.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "number",
          "format": "double",
          "default": 1280.0
        },
        "height": {
          "type": "number",
          "format": "double",
          "default": 800.0
        },
        "min_width": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min_height": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "resizable": {
          "type": "boolean",
          "default": true
        },
        "maximized": {
          "type": "boolean",
          "default": false
        },
        "close_to_tray": {
          "description": "Hide the window instead of quitting when it is closed (the runtime keeps running in the tray).",
          "type": "boolean",
          "default": false
        },
        "tray": {
          "description": "Show a system tray icon.",
          "type": "boolean",
          "default": true
        },
        "devtools": {
          "description": "Enable WebView devtools. Defaults to `true` in development mode only.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "title_bar": {
          "description": "`native` (default): the system's title bar. `overlay`: the frontend draws its own title bar –\nno system title bar on Windows and Linux, the window buttons over the content on macOS. The\nfrontend gets `window.__OPENSHELL__.window` (drag, minimize, maximize, close, runtime menu).",
          "$ref": "#/$defs/TitleBar",
          "default": "native"
        },
        "enabled": {
          "description": "Open a window. `false`: no window – the app runs in the tray / background (services,\ndatabases, agent tools). Apps without a frontend show OpenShell's console in the window.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "TitleBar": {
      "description": "Who draws the window's title bar.",
      "type": "string",
      "enum": [
        "native",
        "overlay"
      ]
    },
    "FrontendConfig": {
      "description": "The web frontend. Framework-agnostic: OpenShell only needs a URL to load,\na command that serves it (dev server) or a directory of built files.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Dev server command, e.g. `npm run dev`.",
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "port": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "description": "URL loaded into the WebView (dev server or external URL).",
          "type": [
            "string",
            "null"
          ]
        },
        "dist": {
          "description": "Directory with built static files (served by OpenShell itself).",
          "type": [
            "string",
            "null"
          ]
        },
        "build": {
          "description": "Production build command (`openshell build`).",
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "proxy": {
          "description": "Reverse proxy rules for the static server, e.g. `{\"/api\": \"${services.backend.url}\"}`.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "watch": {
          "description": "Paths that reload the WebView when changed (development mode, static frontends).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "healthcheck": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthCheckSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "description": "Services that must be healthy before the frontend starts.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "production": {
          "description": "Overrides used in production mode.",
          "anyOf": [
            {
              "$ref": "#/$defs/FrontendOverride"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CommandSpec": {
      "description": "A command, either as a shell string (`\"npm run dev\"`, executed through the\nplatform shell) or as an argument vector (`[\"python\", \"main.py\"]`, executed directly).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "PortSpec": {
      "description": "A port: a fixed number or `\"auto\"` to let OpenShell pick a free port.\nThe chosen port is exposed to the process as `PORT` and as `${port}` /\n`${services.<name>.port}` in the configuration.",
      "anyOf": [
        {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "string"
        }
      ]
    },
    "SetupConfig": {
      "description": "A one-time preparation step, e.g. `npm install`.",
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandSpec"
        },
        "creates": {
          "description": "Skip the setup if this path (relative to the project root) exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "description": "Working directory (defaults to the service working directory).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "HealthCheckSpec": {
      "description": "Health check: either a URL string (HTTP GET, 2xx/3xx is healthy) or a detailed object.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/HealthCheck"
        }
      ]
    },
    "HealthCheck": {
      "type": "object",
      "properties": {
        "http": {
          "description": "HTTP URL that must answer with 2xx/3xx.",
          "type": [
            "string",
            "null"
          ]
        },
        "tcp": {
          "description": "`host:port` that must accept TCP connections.",
          "type": [
            "string",
            "null"
          ]
        },
        "interval_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5000
        },
        "timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 2000
        },
        "failure_threshold": {
          "description": "Consecutive failures before a running service is reported as unhealthy.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 3
        },
        "ready_timeout_ms": {
          "description": "How long a starting service may take to become healthy.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 60000
        }
      },
      "additionalProperties": false
    },
    "FrontendOverride": {
      "type": "object",
      "properties": {
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "dist": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ServiceConfig": {
      "description": "An external component managed (or monitored) by the runtime.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Unique name (`[a-z0-9_-]`), used by CLI, API and agents.",
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Informational category: `backend`, `database`, `worker`, `ai`, ...",
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "description": "Command to run. Omit for external services.",
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "args": {
          "description": "Extra arguments appended to `command`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "description": "Working directory relative to the project root.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "port": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "description": "Base URL of the service. Defaults to `http://127.0.0.1:<port>` when a port is set.",
          "type": [
            "string",
            "null"
          ]
        },
        "external": {
          "description": "The service is already running elsewhere: do not spawn it, only monitor it.",
          "type": "boolean",
          "default": false
        },
        "healthcheck": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthCheckSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "restart": {
          "description": "Restart policy (default: on-failure).",
          "anyOf": [
            {
              "$ref": "#/$defs/RestartSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_restarts": {
          "description": "Maximum restarts within one minute before the service is marked as failed.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 5
        },
        "depends_on": {
          "description": "Services that must be healthy before this one starts.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "autostart": {
          "description": "Start automatically with the runtime.",
          "type": "boolean",
          "default": true
        },
        "setup": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "build": {
          "description": "Build step for compiled services (C++, Java, Go, Rust, ...). Runs before every start in\ndevelopment mode and during `openshell build` / `openshell package`.",
          "anyOf": [
            {
              "$ref": "#/$defs/BuildSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "openapi": {
          "description": "Import the service's OpenAPI document as agent capabilities (path on the service, URL or file).",
          "anyOf": [
            {
              "$ref": "#/$defs/OpenApiSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "watch": {
          "description": "Paths (relative to the project root) that trigger a restart when changed (development mode).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modes": {
          "description": "Only run in these modes (default: all).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Mode"
          }
        },
        "platforms": {
          "description": "Only run on these platforms (default: all). Example: `[\"desktop\", \"server\"]` for a service\nthat needs a toolchain which is not available on Android.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Platform"
          }
        },
        "background": {
          "description": "Behaviour while the app is in the background on mobile platforms (default: `keep`).",
          "anyOf": [
            {
              "$ref": "#/$defs/BackgroundPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_timeout_ms": {
          "description": "Grace period between the stop signal and a forced kill.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "RestartSpec": {
      "description": "`true` (= on-failure), `false` (= never) or an explicit policy.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/RestartPolicy"
        }
      ]
    },
    "RestartPolicy": {
      "description": "When a crashed process is restarted.",
      "type": "string",
      "enum": [
        "never",
        "on-failure",
        "always"
      ]
    },
    "BuildSpec": {
      "description": "A build command (`\"cmake --build build\"`) or a detailed object.",
      "anyOf": [
        {
          "$ref": "#/$defs/CommandSpec"
        },
        {
          "$ref": "#/$defs/BuildConfig"
        }
      ]
    },
    "BuildConfig": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandSpec"
        },
        "cwd": {
          "description": "Working directory (defaults to the service working directory).",
          "type": [
            "string",
            "null"
          ]
        },
        "on_start": {
          "$ref": "#/$defs/BuildWhen",
          "default": "development"
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "BuildWhen": {
      "description": "When a service build step runs automatically before the service starts.",
      "oneOf": [
        {
          "description": "Before every start in development mode (default).",
          "type": "string",
          "const": "development"
        },
        {
          "description": "Before every start in all modes.",
          "type": "string",
          "const": "always"
        },
        {
          "description": "Only via `openshell build` / `openshell package`.",
          "type": "string",
          "const": "never"
        }
      ]
    },
    "OpenApiSpec": {
      "description": "Where to find an OpenAPI 3 document: a path on the service (`\"/openapi.json\"`),\nan absolute URL, a file in the project, or a detailed object.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/OpenApiConfig"
        }
      ]
    },
    "OpenApiConfig": {
      "type": "object",
      "properties": {
        "location": {
          "description": "Path on the service, absolute URL or project file.",
          "type": "string"
        },
        "include": {
          "description": "Only import operations whose operationId or path contains one of these strings.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "description": "Skip operations whose operationId or path contains one of these strings.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prefix": {
          "description": "Prefix for the generated capability names.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "location"
      ]
    },
    "Mode": {
      "description": "Operating mode of the shell.",
      "oneOf": [
        {
          "description": "Project files are used directly, hot reload, broad agent access.",
          "type": "string",
          "const": "development"
        },
        {
          "description": "Stable runtime for end users, restricted agent access.",
          "type": "string",
          "const": "production"
        }
      ]
    },
    "Platform": {
      "description": "Platform an OpenShell runtime runs on. The core is the same everywhere; a platform\nadapter decides how processes are started and how the app lifecycle is handled.",
      "oneOf": [
        {
          "description": "Windows, macOS and Linux with a native window (also `--headless` on a workstation).",
          "type": "string",
          "const": "desktop"
        },
        {
          "description": "Android phones and tablets: the app runs as a personal runtime and mini server.",
          "type": "string",
          "const": "android"
        },
        {
          "description": "A machine without a user session (headless runtime, always on).",
          "type": "string",
          "const": "server"
        }
      ]
    },
    "BackgroundPolicy": {
      "description": "What happens to a service while the app is in the background (mobile platforms;\non the desktop the app never goes to the background).",
      "oneOf": [
        {
          "description": "Keep running (on Android this keeps a foreground service with a notification alive).",
          "type": "string",
          "const": "keep"
        },
        {
          "description": "Stop while the app is in the background and start again when it returns.",
          "type": "string",
          "const": "pause"
        }
      ]
    },
    "RuntimeConfig": {
      "type": "object",
      "properties": {
        "autostart": {
          "description": "Start all services automatically when the shell starts.",
          "type": "boolean",
          "default": true
        },
        "background_mode": {
          "description": "Keep the runtime running in the background when the window is closed.",
          "type": "boolean",
          "default": false
        },
        "control_port": {
          "description": "Fixed port for the local control API (default: random free port).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "log_buffer_lines": {
          "description": "Number of log lines kept in memory (all services).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 10000
        },
        "shutdown_timeout_ms": {
          "description": "Grace period for stopping services before they are killed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5000
        },
        "launch_at_login": {
          "description": "Start the installed app when the user logs in (applies to installed apps only).",
          "type": "boolean",
          "default": false
        },
        "remote": {
          "description": "Make the app usable from other devices (for example a phone that hosts the app and a\nlaptop that uses it). Off by default.",
          "$ref": "#/$defs/RemoteConfig"
        }
      },
      "additionalProperties": false
    },
    "RemoteConfig": {
      "description": "Remote access gateway: serves the app profile (the app's own functions over MCP) to\nother devices in the network, protected by a pairing token.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Start the gateway.",
          "type": "boolean",
          "default": false
        },
        "bind": {
          "description": "Address to listen on. `0.0.0.0` makes the gateway reachable in the local network; use a\nVPN address (for example a Tailscale IP) to limit it to your own devices.",
          "type": "string",
          "default": "0.0.0.0"
        },
        "port": {
          "description": "Fixed port (default: 7420).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 7420
        }
      },
      "additionalProperties": false
    },
    "AgentsConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable the Agent Interaction Layer (tools, MCP, UI bridge).",
          "type": "boolean",
          "default": true
        },
        "permissions": {
          "description": "Scopes granted to agents.",
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_required": {
          "description": "Scopes whose actions need explicit human approval. Default: `[\"system\"]`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Permission"
          }
        },
        "approval_timeout_ms": {
          "description": "How long to wait for a human decision before denying.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 120000
        },
        "sdk_permissions": {
          "description": "Scopes granted to the frontend through the SDK. Default: `[\"read\", \"ui\"]`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Permission"
          }
        },
        "providers": {
          "description": "AI providers known to this application (for discovery by agents).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderConfig"
          }
        },
        "detect_local_providers": {
          "description": "Probe well-known local providers (Ollama, LM Studio).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "PermissionSpec": {
      "description": "Either one permission list for all modes or one per mode.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Permission"
          }
        },
        {
          "type": "object",
          "properties": {
            "development": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/Permission"
              }
            },
            "production": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/Permission"
              }
            }
          }
        }
      ]
    },
    "Permission": {
      "description": "Permission scopes for agents. Every agent tool requires exactly one scope.",
      "oneOf": [
        {
          "description": "Read state, status, logs, capabilities.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Inspect and operate the user interface.",
          "type": "string",
          "const": "ui"
        },
        {
          "description": "Invoke application capabilities that change data.",
          "type": "string",
          "const": "actions"
        },
        {
          "description": "Start, stop and restart services.",
          "type": "string",
          "const": "services"
        },
        {
          "description": "Read project files.",
          "type": "string",
          "const": "files"
        },
        {
          "description": "Modify project files.",
          "type": "string",
          "const": "code"
        },
        {
          "description": "Native system access: notifications, declared tasks, script evaluation.",
          "type": "string",
          "const": "system"
        }
      ]
    },
    "ProviderConfig": {
      "description": "An AI provider connection. OpenShell does not run models itself; it only\nmakes providers discoverable to agents and the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_key_env": {
          "description": "Name of the environment variable holding the API key (the key itself never goes into the config).",
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ]
    },
    "ProviderKind": {
      "type": "string",
      "enum": [
        "ollama",
        "lm-studio",
        "openai-compatible",
        "openai",
        "anthropic",
        "mcp",
        "custom"
      ]
    },
    "CapabilityConfig": {
      "description": "A function of the application that agents can discover and invoke.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Unique name (`[a-z0-9_]`).",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "permission": {
          "description": "Required scope. `read` for queries, `actions` (alias `write`) for changes.",
          "$ref": "#/$defs/Permission",
          "default": "read"
        },
        "input_schema": {
          "description": "JSON Schema of the input object."
        },
        "http": {
          "description": "Invoke by calling an HTTP endpoint.",
          "anyOf": [
            {
              "$ref": "#/$defs/HttpTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "description": "Invoke by running a declared task.",
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "description": "Invoke by running a script/program: it receives the input as JSON on stdin (and in\n`OPENSHELL_INPUT`) and prints its result (JSON or text) on stdout. No server needed.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunSpec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ]
    },
    "HttpTarget": {
      "type": "object",
      "properties": {
        "service": {
          "description": "Service whose base URL is used.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Absolute URL (alternative to `service` + `path`).",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "default": "POST"
        },
        "path": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "RunSpec": {
      "description": "A function implemented as a program: a command (`[\"python\", \"tools/greet.py\"]`) or a detailed object.",
      "anyOf": [
        {
          "$ref": "#/$defs/CommandSpec"
        },
        {
          "$ref": "#/$defs/RunConfig"
        }
      ]
    },
    "RunConfig": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandSpec"
        },
        "cwd": {
          "description": "Working directory relative to the project root (default: project root).",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 60000
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "TaskSpec": {
      "description": "A task: a shell string / argv, or a detailed object.",
      "anyOf": [
        {
          "$ref": "#/$defs/CommandSpec"
        },
        {
          "$ref": "#/$defs/TaskConfig"
        }
      ]
    },
    "TaskConfig": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandSpec"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 300000
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "PackageConfig": {
      "description": "Settings for `openshell package` (native installers).",
      "type": "object",
      "properties": {
        "identifier": {
          "description": "Bundle identifier (default: `app.id`, else `dev.openshell.<name>`).",
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        },
        "copyright": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_file": {
          "description": "License file shown by the installer.",
          "type": [
            "string",
            "null"
          ]
        },
        "include": {
          "description": "Files/directories (glob patterns, relative to the project) to ship. Default: the whole project\nexcept `.git`, `.openshell`, `node_modules`, `__pycache__` and virtualenvs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "description": "Glob patterns to leave out.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "description": "Installer formats: `nsis`, `msi` (Windows), `app`, `dmg` (macOS), `deb`, `rpm`, `appimage` (Linux).\nDefault: `nsis` / `dmg` / `deb` + `appimage`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DatabaseConfig": {
      "description": "A database managed by OpenShell.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Unique name (`[a-z0-9_]`), e.g. `main`.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/DatabaseKind",
          "default": "sqlite"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Database file. Relative paths are inside the app's data directory (`OPENSHELL_DATA_DIR`),\nso installed apps keep their data per user. Default: `<name>.db`.",
          "type": [
            "string",
            "null"
          ]
        },
        "migrations": {
          "description": "Directory (relative to the project) with `*.sql` migrations, applied once each, in file-name order.",
          "type": [
            "string",
            "null"
          ]
        },
        "agent_access": {
          "description": "Agent access: `none`, `read` (default) or `write`.",
          "$ref": "#/$defs/DatabaseAccess",
          "default": "read"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "DatabaseKind": {
      "description": "Database engines OpenShell manages itself.",
      "type": "string",
      "enum": [
        "sqlite"
      ]
    },
    "DatabaseAccess": {
      "description": "What agents may do with a database (the app's own frontend always has access via the SDK\nwithin `agents.sdk_permissions`).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "`db_list`, `db_schema`, `db_query` (SELECT only).",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Additionally `db_execute` (INSERT/UPDATE/DELETE/DDL) – needs the `actions` scope.",
          "type": "string",
          "const": "write"
        }
      ]
    }
  }
}
